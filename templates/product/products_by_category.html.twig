{% extends 'base.html.twig' %}

{% block title %}{{ category.name }} - Notre Boutique{% endblock %}

{% block body %}

    {# Breadcrumb #}
    <div class="container mt-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a href="{{ path('productbrowse_categories') }}" class="text-decoration-none">Accueil</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="{{ path('productbrowse_categories') }}" class="text-decoration-none">Catégories</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">{{ category.name }}</li>
            </ol>
        </nav>
    </div>

    {# Jumbotron #}
    <div class="container my-4">
        <div class="p-5 mb-4 bg-primary bg-gradient text-white rounded-3">
            <div class="container-fluid py-3">
                <h1 class="display-4 fw-bold">{{ category.name }}</h1>
                {% if category.description %}
                    <p class="col-md-8 fs-5">{{ category.description }}</p>
                {% endif %}
                <span class="badge bg-light text-dark fs-6">{{ products|length }} produit(s) disponible(s)</span>
            </div>
        </div>
    </div>

    {# Products Grid #}
    <div class="container mb-5">
        <div class="row mb-4">
            <div class="col">
                <h3>Parcourir {{ category.name }}</h3>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-md-3 g-4">
            {% for product in products %}
                <div class="col">
                    <div class="card h-100">
                        {% if product.image %}
                            <img src="{{ asset('uploads/products/' ~ product.image) }}"
                                 class="card-img-top"
                                 alt="{{ product.name }}">
                        {% else %}
                            <img src="https://via.placeholder.com/400x300?text={{ product.name|url_encode }}"
                                 class="card-img-top"
                                 alt="{{ product.name }}">
                        {% endif %}
                        <div class="card-body">
                            <span class="badge bg-primary mb-2">{{ category.name }}</span>
                            <h5 class="card-title">{{ product.name }}</h5>
                            <p class="card-text fw-bold text-success">{{ product.price|number_format(2, ',', ' ') }} €</p>
                            {% if product.stock > 0 %}
                                <a href="{{ path('productproduct_details', { slug: product.slug }) }}"
                                   class="btn btn-outline-primary">
                                    Voir le détail
                                </a>
                            {% else %}
                                <button class="btn btn-outline-secondary" disabled>Rupture de stock</button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info text-center">
                        Aucun produit disponible dans cette catégorie pour le moment.
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

{% endblock %}
