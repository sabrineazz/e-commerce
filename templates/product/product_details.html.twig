{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Notre Boutique{% endblock %}

{% block body %}

    <div class="container my-5">
        <div class="row">

            {# Product Image #}
            <div class="col-md-6">
                {% if product.image %}
                    <img src="{{ asset('uploads/products/' ~ product.image) }}"
                         class="img-fluid rounded"
                         alt="{{ product.name }}">
                {% else %}
                    <img src="https://via.placeholder.com/600x500?text={{ product.name|url_encode }}"
                         class="img-fluid rounded"
                         alt="{{ product.name }}">
                {% endif %}
            </div>

            {# Product Information #}
            <div class="col-md-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a href="{{ path('productbrowse_categories') }}" class="text-decoration-none">Accueil</a>
                        </li>
                        {% if product.category is defined and product.category %}
                            <li class="breadcrumb-item">
                                <a href="{{ path('productproducts_by_category', { slug: product.category.slug }) }}"
                                   class="text-decoration-none">
                                    {{ product.category.name }}
                                </a>
                            </li>
                        {% endif %}
                        <li class="breadcrumb-item active" aria-current="page">{{ product.name }}</li>
                    </ol>
                </nav>

                {% if product.category is defined and product.category %}
                    <span class="badge bg-primary mb-3">{{ product.category.name }}</span>
                {% endif %}

                <h1 class="mb-3">{{ product.name }}</h1>

                <h3 class="text-success mb-4">{{ product.price|number_format(2, ',', ' ') }} €</h3>

                {% if product.description %}
                    <div class="mb-4">
                        <h5>Description</h5>
                        <p class="text-muted">{{ product.description }}</p>
                    </div>
                {% endif %}

                {# Add to Cart Form #}
                {% if product.stock > 0 %}
                    <form action="" method="post">
                        <input type="hidden" name="productId" value="{{ product.id }}">

                        <div class="mb-3">
                            <label for="quantity" class="form-label">Quantité</label>
                            <input type="number"
                                   class="form-control"
                                   id="quantity"
                                   name="quantity"
                                   value="1"
                                   min="1"
                                   max="{{ product.stock }}"
                                   style="max-width: 100px;">
                        </div>

                        <div class="d-grid gap-2 d-md-flex">
                            <button type="submit" class="btn btn-primary btn-lg">Ajouter au panier</button>
                            {% if product.category is defined and product.category %}
                                <a href="{{ path('productproducts_by_category', { slug: product.category.slug }) }}"
                                   class="btn btn-outline-secondary btn-lg">
                                    Continuer les achats
                                </a>
                            {% else %}
                                <a href="{{ path('productbrowse_categories') }}"
                                   class="btn btn-outline-secondary btn-lg">
                                    Continuer les achats
                                </a>
                            {% endif %}
                        </div>
                    </form>
                {% else %}
                    <div class="alert alert-warning">Ce produit est actuellement en rupture de stock.</div>
                    <a href="{{ path('productbrowse_categories') }}" class="btn btn-outline-secondary btn-lg">
                        Continuer les achats
                    </a>
                {% endif %}

                {# Additional Info #}
                <div class="mt-4 pt-4 border-top">
                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>Référence :</strong> {{ product.slug }}</li>
                        <li class="mb-2">
                            <strong>Disponibilité :</strong>
                            {% if product.stock > 0 %}
                                <span class="text-success">En stock ({{ product.stock }} disponible(s))</span>
                            {% else %}
                                <span class="text-danger">Rupture de stock</span>
                            {% endif %}
                        </li>
                        {% if product.category is defined and product.category %}
                            <li class="mb-2"><strong>Catégorie :</strong> {{ product.category.name }}</li>
                        {% endif %}
                    </ul>
                </div>
            </div>

        </div>
    </div>

{% endblock %}
